# Obelisk Dagster Service — runs the real workspace (backend + dags + SDK deps)
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 DAGSTER_HOME=/opt/obelisk/dagster_home PYTHONPATH=/opt/obelisk/backend

RUN mkdir -p /opt/obelisk/dagster_home /opt/obelisk

# Dagster version pinned to the host venv (W5 plan Step 1: 1.13.26)
RUN pip install --no-cache-dir dagster==1.13.26 dagster-webserver==1.13.26 "pydantic-settings>=2.2.0,<3" "cryptography>=42.0.5" "httpx>=0.27.0" "duckdb>=0.10.0" "polars>=0.20.15" "pyarrow>=15.0.0" "psycopg2-binary>=2.9.9" "pymongo>=4.6.2" "pymysql>=1.1.0" "oracledb>=2.1.0"

WORKDIR /opt/obelisk
CMD ["bash", "/opt/obelisk/git_repo/dagster_workspace/entrypoint.sh"]