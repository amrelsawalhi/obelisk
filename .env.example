OBELISK_MASTER_KEY=dGhpcy1pcy1hLXNhbXBsZS0zMi1ieXRlLWtleS0xMjM0NTY=
# Where the lakehouse lives. A checkout resolves this container default to
# <repo>/data/lakehouse. docker-compose.yml pins its own value (file:///app/data/lakehouse)
# so the data lands on the ./data bind mount instead of the container's writable layer --
# that override is intentional and is not read from this file.
STORAGE_URI=file:///data/lakehouse
DATABASE_URL=sqlite+aiosqlite:///data/obelisk.db
OBELISK_NET=obelisk_net
OBELISK_ADMIN_USER=admin
OBELISK_ADMIN_PASSWORD=obelisk2026
# Seconds a notebook kernel stays alive after its browser tab disconnects (0 = never expire)
MARIMO_SESSION_TTL_SECONDS=600

# Where the headless notebook server binds. It runs with --no-token, which is an
# unauthenticated editor (remote code execution), so it stays on loopback. Only change
# this when something in front of it authenticates first.
# MARIMO_HOST=127.0.0.1

# --- DuckDB budget ---------------------------------------------------------
# How many connections may do heavy work at once. "auto" derives the pool from this
# machine: max(4, min(cpus / DUCKDB_MIN_THREADS_PER_SLOT, memory pool / 4 GiB, 32)).
# Each connection's memory limit is the pool divided by this number, so raising it
# shrinks every share instead of raising the total. An integer overrides.
# DUCKDB_MAX_CONCURRENT_HEAVY=auto
# Threads a heavy slot needs before "auto" adds another slot. Raise for fewer, fatter
# slots; lower for more concurrent interactive users.
# DUCKDB_MIN_THREADS_PER_SLOT=4
# Cheap queries (metadata statements, single-table SELECTs with a small LIMIT) get
# their own pool, so a preview is never queued behind a scan or a dbt build. "auto"
# is half the heavy pool, capped at 8.
# DUCKDB_MAX_CONCURRENT_LIGHT=auto
# How many ingests run at once (each holds one of the slots above for its whole run).
# OBELISK_INGEST_MAX_CONCURRENT=2
# Spill ceiling. "0" means no config cap: each connection may use
# DUCKDB_TEMP_SPILL_FREE_DISK_PCT of the spill volume's current free space, divided by
# the slot count. Set a size (binary units: 512GiB) to impose an absolute cap as well.
# DUCKDB_TEMP_SIZE_LIMIT=0
# DUCKDB_TEMP_SPILL_FREE_DISK_PCT=50
# How much of the heavy pool a lakehouse dbt run reserves. "auto" = half: models run
# serially, so the run never needed all of it. Writers are excluded from each other
# separately, so lowering this cannot corrupt a table.
# OBELISK_DBT_RESERVED_SLOTS=auto
# Files rewritten by one auto/API compaction pass. Larger backlogs should drain via
# the scheduled CLI maintenance job rather than blocking an ingest or HTTP request.
# OBELISK_LAKEHOUSE_COMPACT_MAX_FILES=50
# SQLite journal/synchronous modes for BOTH SQLite files (the control plane and the
# DuckLake metadata catalog). Keep WAL/NORMAL on local ext4/XFS. On a virtual
# filesystem that rejects mmap or fsync, choose DELETE/OFF explicitly; that trades
# power-loss durability for compatibility.
# OBELISK_SQLITE_JOURNAL_MODE=WAL
# OBELISK_SQLITE_SYNCHRONOUS=NORMAL
# Eager SDK readers (query/query_arrow) build the whole result in memory. Past this
# many rows they raise and point at iter_batches()/lazy_query(). 0 removes the cap.
# OBELISK_SDK_QUERY_ROW_LIMIT=1000000
# Network interface for companion database services (Postgres, ClickHouse, Redpanda)
# OBELISK_SERVICE_BIND_HOST=127.0.0.1
# Whether unsigned DuckDB community extensions (e.g. Mongo scanner) are permitted
# OBELISK_ALLOW_COMMUNITY_EXTENSIONS=true

# --- Auth -------------------------------------------------------------------
# Enforcement is off by default for a local, single-operator install: the API and the
# sockets already resolve a principal (app/core/security.py), so flipping this to 1
# gates every /api route and every socket (/api/auth/login and /health stay open).
#
# Two things are still guarded while it is off:
#   * the terminal only opens for a loopback client;
#   * a deployment with ENVIRONMENT=production and a non-loopback HOST refuses to start
#     unless OBELISK_AUTH_ENABLED=1, HOST=127.0.0.1, or OBELISK_ALLOW_UNAUTHENTICATED=1
#     is set. That last one is an explicit "I know this port is private" decision.
OBELISK_AUTH_ENABLED=0
# OBELISK_ALLOW_UNAUTHENTICATED=1
# The Compose file flips OBELISK_AUTH_ENABLED to 1: the container binds 0.0.0.0, so it
# starts authenticated and refuses to boot with the shipped admin password.
# Session cookie: set Secure=1 behind HTTPS; TTL in seconds (stolen cookies live this long).
# OBELISK_SESSION_SECURE_COOKIE=0
# OBELISK_SESSION_TTL_SECONDS=604800
# Login brute-force protection (failures before lockout / lockout seconds).
# OBELISK_AUTH_MAX_FAILED_ATTEMPTS=10
# OBELISK_AUTH_LOCKOUT_SECONDS=300
# Reverse proxies whose X-Forwarded-For the unauthenticated terminal gate may believe.
# OBELISK_TRUSTED_PROXIES=
# Extra browser origins allowed to open sockets and to send the session cookie,
# comma separated. Same-host, loopback and Vite's dev server are always allowed; set
# this when a reverse proxy rewrites the Host header.
OBELISK_ALLOWED_ORIGINS=

# --- In-app terminal --------------------------------------------------------
# The terminal spawns a real shell as the backend's OS user. Set to 0 on a shared or
# internet-facing deployment to remove that capability without touching code.
OBELISK_TERMINAL=1
