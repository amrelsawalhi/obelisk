{
    admin off
    auto_https off
}

:80 {
    # Obelisk REST API Backend
    handle /api/* {
        reverse_proxy obelisk-core:8000
    }

    # Apache Superset BI runs at its own address (host:8088) and is linked there, not
    # proxied under a subpath: Superset needs SUPERSET_WEBSERVER_BASEURL *and*
    # APPLICATION_ROOT to serve under one, and a half-configured subpath answered a
    # Flask 404 for every page. There is deliberately no /superset route here.

    # Reactive Marimo Notebook Server (Configured with --base-url /notebooks)
    # Marimo runs with --no-token, so the gateway authenticates every request before
    # it is proxied. /api/auth/verify answers 204 only for a valid session (and for
    # everyone while OBELISK_AUTH_ENABLED=0, so this stays a no-op on a local install).
    handle /notebooks/* {
        forward_auth obelisk-core:8000 {
            uri /api/auth/verify
            copy_headers X-Obelisk-User X-Obelisk-Role
        }
        reverse_proxy obelisk-core:2718
    }

    # Air-Gapped Gitea Git Repository
    # Gitea mounts every route at "/" (routers/init.go: r.Mount("/", ...)); the
    # subpath in ROOT_URL only prefixes the links Gitea *generates*. The proxy
    # must therefore strip /gitea before forwarding. Bare /gitea is normalized to
    # /gitea/ so the prefix matcher below applies (the UI links to "/gitea").
    # The same session gate as /notebooks applies: Gitea is only reachable once
    # the Obelisk session check passes (it then has its own login).
    redir /gitea /gitea/ 308
    handle_path /gitea/* {
        forward_auth obelisk-core:8000 {
            uri /api/auth/verify
            copy_headers X-Obelisk-User X-Obelisk-Role
        }
        reverse_proxy obelisk_gitea:3000
    }

    # React 18 Frontend SPA
    handle {
        root * /srv/dist
        try_files {path} /index.html
        file_server
    }
}
